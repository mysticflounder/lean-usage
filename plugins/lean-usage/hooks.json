{
  "lean-anchor": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "python3 ./hooks/sync-lake-build.py",
        "timeout": 5
      },
      {
        "type": "command",
        "command": "python3 ./hooks/inject_anchor.py",
        "timeout": 8
      }
    ]
  },
  "lean-guards": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./hooks/lean-direct-warn.py",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python3 ./hooks/mathlib-cache-check.py",
            "timeout": 5
          }
        ]
      }
    ]
  }
}

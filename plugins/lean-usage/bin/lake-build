#!/usr/bin/env python3
# Copyright (c) 2026 Adam McKenna
# Released under GPL-3.0-or-later as described in the file LICENSE.
# Author: Adam McKenna <adam@mysticflounder.ai>
#
# lake-build — global Lean / Lake build wrapper. Works from anywhere inside a
# Lake project: walks up to the lakefile, serializes top-level builds with a
# stale-pid-aware lockfile, prefetches mathlib's binary cache before building,
# caps each `lean` worker's memory via a PATH shim,
# records per-build timing + how many targets recompiled (0 = fully-cached
# no-op) to a JSONL stats file, and nudges when a build crosses the time budget.
# It also records each module's own build time — read straight from Lake's
# "Built <module> (Ns)" progress lines — into a second JSONL file
# (module-build-stats.jsonl). An interrupt (Ctrl-C / SIGTERM) still records a
# partial per-build record and keeps the already-written per-module records.
# In a proof-blueprint project (a .blueprint.toml at or above the Lake tree) it
# runs `proof-blueprint sync` after a successful build to resync the index +
# kernel call graph, then snapshots the open-frontier spine to
# docs/live-blueprint.md; opt out with LAKE_BUILD_NO_REFRESH=1. With
# --spine-archive it then packs the ACTIVE spine sources (the files behind
# `proof-blueprint spine --files`) plus the Lake scaffolding into a .tar.gz.
# Deployed to ~/.local/bin/lake-build by the lean-usage SessionStart hook.
"""Python port of the lake-build wrapper (formerly a bash script).

Passthrough: any ARGS are forwarded verbatim to `lake build ARGS`. The wrapper
consumes only a leading `-h`/`--help` and `--spine-archive[=PATH]` (off by
default), both before the first `--`; a leading `--` forces everything after it
to be forwarded (so `lake-build -- --help` reaches Lake's own build help).
"""

import atexit
import json
import os
import shutil
import signal
import subprocess
import sys
import tarfile
import tempfile
import time
from datetime import datetime, timezone

PROG = "lake-build"

# The one wrapper-owned flag (everything else forwards to `lake build`). Bare
# form uses SPINE_ARCHIVE_DEFAULT; `=PATH` overrides. The `=` form is required —
# a space-separated value would be indistinguishable from a build target.
SPINE_ARCHIVE_FLAG = "--spine-archive"
SPINE_ARCHIVE_DEFAULT = "spine.tar.gz"

# Lake-root files that make the archived sources a buildable tree. Copied when
# present; a missing one is not an error (not every project has a manifest).
SPINE_ARCHIVE_SCAFFOLDING = (
    "lakefile.toml", "lakefile.lean", "lean-toolchain", "lake-manifest.json",
)

# How many unsatisfied imports to name before collapsing to a count.
SPINE_ARCHIVE_MAX_LISTED = 10

HELP = f"""\
{PROG} — global Lean/Lake build wrapper.

Usage:
  {PROG} [ARGS...]
      Build; ARGS are forwarded verbatim to `lake build`.
  {PROG} {SPINE_ARCHIVE_FLAG}[=PATH]
      After a successful build, also write a .tar.gz of ONLY the ACTIVE spine
      files (default: off). See below.
  {PROG} -- [ARGS...]
      Forward everything after `--` verbatim, even `-h`/`--help`, without this
      wrapper consuming them. Note `lake build` treats `--help` as a build
      argument, not a help flag, so `{PROG} -- --help` runs a build; use
      `lake help build` for Lake's own build help.
  {PROG} -h | --help
      Show this help and exit.

{SPINE_ARCHIVE_FLAG} is the only argument this wrapper interprets besides `-h`
and `--`; it is consumed before the first `--` and never reaches Lake. The bare
form writes <blueprint-project>/{SPINE_ARCHIVE_DEFAULT}; `{SPINE_ARCHIVE_FLAG}=PATH`
writes PATH (a relative PATH resolves against the blueprint project dir). It
needs a proof-blueprint project and the `proof-blueprint` CLI, and runs after
the post-build resync so the file set reflects the build that just finished.

  Contents  The ACTIVE spine sources — every indexed .lean file declaring a
            symbol reachable from the [publish] target_symbol(s), per
            `proof-blueprint spine --files`. Dead and off-spine WIP sources are
            excluded. Plus these, when present at the Lake root:
            {", ".join(SPINE_ARCHIVE_SCAFFOLDING)}.
            Every path is stored under one top-level dir named for the archive,
            at its location relative to the Lake root.
  Caveat    The spine file set is reachability-derived, NOT import-closed: a
            spine file may import a module that contributes no reachable symbol
            and is therefore absent. The wrapper checks this and names every
            unsatisfied project import; the archive is written either way.
  Exit      A requested archive that fails to write reports on stderr and makes
            an otherwise-successful run exit 1. A failing build's exit code is
            never masked, and the archive is skipped.

Runs from anywhere inside a Lake project. It:
  - locates the Lake root by walking up to lakefile.toml/lakefile.lean, or via
    the nearest .blueprint.toml [paths].lean_root (else lean_lib) when invoked
    above a nested Lake tree; $LEAN_ROOT overrides discovery;
  - serializes top-level builds per project with a stale-PID-aware lockfile;
  - retains live build output in lake-build-logs/ beside the lock and prints its path;
  - puts a temporary `lean` shim on PATH to cap each worker's memory ($MEMORY_MB);
  - records each module's own build time into module-build-stats.jsonl (one record
    per module: dotted module name, duration_s, warnings flag, shared build_id),
    read from Lake's own "Built <module> (Ns)" progress lines — disable with
    LAKE_BUILD_NO_MODULE_STATS;
  - appends one timing record per build to the stats JSONL and counts how many
    targets recompiled (0 = fully-cached no-op); an interrupt still records a
    partial record ("interrupted": true) with the elapsed time and count so far;
  - nudges when a build crosses the time budget;
  - after a successful proof-blueprint build, best-effort runs
    `proof-blueprint sync` and rewrites docs/live-blueprint.md
    (skip with LAKE_BUILD_NO_REFRESH=1);
  - optionally packs the ACTIVE spine sources into a .tar.gz (--spine-archive).

Examples:
  {PROG}                   # build the whole project
  {PROG} Foo.Bar           # build one target
  {PROG} --jobs 4          # forwarded to `lake build` (advisory, not a hard cap)
  MEMORY_MB=8192 {PROG}    # tighter per-worker memory cap
  {PROG} --spine-archive   # build, then pack the active spine to spine.tar.gz
  {PROG} --spine-archive=/tmp/p97-spine.tar.gz Foo.Bar

Environment:
  LEAN_ROOT             Explicit Lake root (overrides discovery).
  MEMORY_MB             Per-`lean` memory cap, MB. Default 16384.
  LOCKFILE              PID-lock path. Default <lake-root>/.lake/lake-build.lock.
                        First line: PID; second line: JSON sid/tmux_pane/build_log.
  REAL_LAKE, REAL_LEAN  Explicit toolchain executables. Default: resolved on PATH.
  LEAN_USAGE_STATE_DIR  Stats directory. Default ~/.local/state/lean-usage.
  LAKE_BUILD_TARGET_S   Over-target warning threshold, seconds. Default 600.
  LAKE_BUILD_CEIL_S     Over-ceiling warning threshold, seconds. Default 1800.
  LAKE_BUILD_NO_REFRESH Set to any value to skip the proof-blueprint post-build refresh.
  LAKE_BUILD_NO_MODULE_STATS  Set to any value to skip writing per-module timing
                        records to module-build-stats.jsonl.

Stats files (under <LEAN_USAGE_STATE_DIR>):
  build-stats.jsonl         one JSON object per build (duration, exit, recompiled,
                            build_id, and "interrupted" on a partial build)
  module-build-stats.jsonl  one JSON object per (re)compiled module (module,
                            duration_s, warnings, build_id) — join to a build via
                            build_id
"""


def err(msg: str) -> None:
    """Write one line to stderr (the wrapper's own channel; build output is stdout)."""
    write_build_log(msg + "\n")
    sys.stderr.write(msg + "\n")
    sys.stderr.flush()


def write_build_log(text: str) -> None:
    """Flush output as it arrives so the lock's log can be followed live."""
    log_file = _STATE.get("log_file")
    if log_file is not None:
        try:
            log_file.write(text)
            log_file.flush()
        except (OSError, ValueError) as exc:
            _STATE["log_file"] = None
            try:
                log_file.close()
            except (OSError, ValueError):
                pass
            # Do not route this warning through err(), which also writes logs.
            try:
                sys.stderr.write(f"{PROG}: build log write failed; continuing without logging: {exc}\n")
                sys.stderr.flush()
            except OSError:
                pass


# --- locate the project ---------------------------------------------------
def _abs_dir(start: str | None) -> str | None:
    """Canonicalize `start` (default cwd) to an absolute path; None if it isn't a dir.

    Mirrors the bash `cd "$dir" && pwd` guard, which returns failure when the
    directory does not exist.
    """
    d = os.path.abspath(start if start else os.getcwd())
    return d if os.path.isdir(d) else None


def find_lean_root(start: str | None = None) -> str | None:
    """Walk up from `start` to the nearest dir holding lakefile.toml/lakefile.lean."""
    d = _abs_dir(start)
    if d is None:
        return None
    while True:
        if os.path.isfile(os.path.join(d, "lakefile.toml")) or os.path.isfile(
            os.path.join(d, "lakefile.lean")
        ):
            return d
        parent = os.path.dirname(d)
        if parent == d:  # reached filesystem root
            return None
        d = parent


def uses_mathlib(lean_root: str) -> bool:
    """Return whether the Lake project declares mathlib as a dependency."""
    manifest = os.path.join(lean_root, "lake-manifest.json")
    try:
        with open(manifest, "r", encoding="utf-8") as fh:
            packages = json.load(fh).get("packages", [])
        if any(isinstance(pkg, dict) and pkg.get("name") == "mathlib" for pkg in packages):
            return True
    except (OSError, AttributeError, json.JSONDecodeError):
        pass

    for filename in ("lakefile.toml", "lakefile.lean"):
        try:
            with open(os.path.join(lean_root, filename), "r", encoding="utf-8") as fh:
                if "mathlib" in fh.read().lower():
                    return True
        except OSError:
            pass
    return False


def find_blueprint(start: str | None = None) -> str | None:
    """Walk up from `start` to the nearest .blueprint.toml; return its full path."""
    d = _abs_dir(start)
    if d is None:
        return None
    while True:
        candidate = os.path.join(d, ".blueprint.toml")
        if os.path.isfile(candidate):
            return candidate
        parent = os.path.dirname(d)
        if parent == d:
            return None
        d = parent


def blueprint_paths_value(path: str, keys: tuple[str, ...] = ("lean_root", "lean_lib")) -> str | None:
    """Return the first of `keys` present in a .blueprint.toml's [paths] table.

    The default order is the Lake-root pointer: lean_root (explicit) wins over
    lean_lib (the Lean srcDir). Pass `("lean_lib",)` when you specifically need
    the srcDir — the base the blueprint's own relative paths hang off, which is
    not the same directory when the lakefile sits above it. This is the same
    minimal, quote-stripping, section-aware TOML scan the bash version used
    (no full parser, no regex): drop trailing `#` comments, track the current
    `[section]`, and read simple quoted scalars inside [paths]. Returns None if
    none of `keys` is present.
    """
    found: dict[str, str] = {}
    section = None
    try:
        with open(path, "r", encoding="utf-8", errors="replace") as fh:
            lines = fh.readlines()
    except OSError:
        return None
    for raw in lines:
        line = raw
        hash_at = line.find("#")
        if hash_at >= 0:  # drop trailing comment
            line = line[:hash_at]
        t = line.strip()
        if t == "":
            continue
        if t[0] == "[":  # section header, e.g. [paths] or [[array]]
            section = t.lstrip("[").rstrip("]").strip()
            continue
        if section != "paths":
            continue
        eq = t.find("=")
        if eq < 0:
            continue
        key = t[:eq].strip()
        val = t[eq + 1:].strip()
        if len(val) >= 2:  # strip one layer of matching quotes
            q = val[0]
            if q in ("\"", "'") and val[-1] == q:
                val = val[1:-1]
        if key in keys and val:
            found[key] = val
    for k in keys:
        if k in found:
            return found[k]
    return None


def find_lean_root_via_blueprint() -> str | None:
    """Resolve the Lake root through the nearest .blueprint.toml [paths] pointer.

    Reads the pointer, resolves it relative to the blueprint dir, then walks up
    to the enclosing lakefile (lean_lib is a srcDir that may sit below it).
    """
    bp = find_blueprint(os.getcwd())
    if not bp:
        return None
    bp_dir = os.path.dirname(bp)
    val = blueprint_paths_value(bp)
    if not val:
        return None
    return find_lean_root(os.path.join(bp_dir, val))


# --- lockfile (stale-pid aware) -------------------------------------------
# Populated once we know the paths so the atexit/signal cleanup can reach them.
_STATE = {"wrap_dir": None, "lockfile": None, "lock_held": False, "log_file": None}

# Per-build stats state, reachable from the atexit/signal finalizer so an
# interrupted build still records a partial record. `meta` holds the static
# fields (project, args, build_id, memory_mb); `start`/`recompiled`/`exit_code`
# evolve during the run; `recorded` makes finalize idempotent (normal completion
# records once, the atexit fallback then no-ops); `proc` lets a signal terminate
# the running lake so the partial record reflects a real stop.
_BUILD = {
    "start": None, "recompiled": 0, "exit_code": None,
    "recorded": False, "stats_file": None, "meta": None, "proc": None,
}


def finalize_build_stats(interrupted: bool = True) -> None:
    """Append the per-build record exactly once. Called explicitly on normal
    completion (interrupted=False) and via atexit on any early exit
    (interrupted=True, the default) so a Ctrl-C / SIGTERM still leaves a partial
    record. Best-effort: a write failure never propagates."""
    if _BUILD["recorded"] or _BUILD["start"] is None or _BUILD["meta"] is None:
        return
    _BUILD["recorded"] = True
    duration = int(time.time() - _BUILD["start"])
    code = _BUILD["exit_code"]
    if code is None:
        code = 130  # exited before the build returned → treat as SIGINT
    try:
        record = dict(_BUILD["meta"])
        record.update({
            "ts": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
            "duration_s": duration,
            "exit_code": code,
            "recompiled": _BUILD["recompiled"],
            "interrupted": interrupted,
        })
        with open(_BUILD["stats_file"], "a", encoding="utf-8") as fh:
            fh.write(json.dumps(record) + "\n")
    except OSError:
        pass


def cleanup() -> None:
    """Remove the PATH-shim dir and, if we own it, the lockfile.

    Unlike the original bash trap — which unconditionally `rm -f`'d the lockfile
    and so could delete a *concurrent* build's lock when this process bailed out
    on a busy lock — we only remove the lockfile when this process actually
    acquired it (`lock_held`).
    """
    wd = _STATE["wrap_dir"]
    if wd:
        shutil.rmtree(wd, ignore_errors=True)
    log_file = _STATE.get("log_file")
    if log_file is not None:
        _STATE["log_file"] = None
        try:
            log_file.close()
        except OSError:
            pass
    if _STATE["lock_held"] and _STATE["lockfile"]:
        try:
            os.unlink(_STATE["lockfile"])
        except OSError:
            pass


def _signal_exit(signum, _frame):
    # Route signals through the normal exit path so atexit (finalize + cleanup)
    # runs. Record the signal-derived exit code and terminate the running lake
    # so the partial build record reflects a real stop (and no orphaned build).
    _BUILD["exit_code"] = 128 + signum
    proc = _BUILD["proc"]
    if proc is not None:
        try:
            proc.terminate()
        except Exception:
            pass
    sys.exit(128 + signum)


def calling_session() -> dict:
    """Record only explicit caller identity; ordinary shells may have no SID."""
    sid = next((os.environ[name].strip() for name in (
        "CODEX_THREAD_ID", "CODEX_SESSION_ID", "OPENCODE_SESSION_ID",
        "CLAUDE_SESSION_ID", "CLAUDE_CODE_SESSION_ID",
    ) if os.environ.get(name, "").strip()), None)
    return {"sid": sid, "tmux_pane": os.environ.get("TMUX_PANE", "").strip() or None}


def acquire_lock(lockfile: str, build_log: str | None = None) -> None:
    """Take a PID lock with caller metadata, reclaiming it if the PID is dead.

    Keep the PID alone on line one so older wrappers can still read this lock.
    Optional JSON on line two is informational and never changes PID liveness.
    """
    metadata = {**calling_session(), "build_log": build_log}
    payload = f"{os.getpid()}\n{json.dumps(metadata)}\n".encode()
    while True:
        try:
            fd = os.open(lockfile, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o644)
        except FileExistsError:
            lock_pid = None
            alive = False
            owner = {}
            try:
                with open(lockfile, "r", encoding="utf-8", errors="replace") as fh:
                    first = fh.readline().strip()
                    try:
                        metadata = json.loads(fh.readline())
                        if isinstance(metadata, dict):
                            owner = metadata
                    except ValueError:
                        pass  # legacy PID-only or malformed metadata
                if first.isdigit():
                    lock_pid = int(first)
                    try:
                        os.kill(lock_pid, 0)
                        alive = True  # process exists
                    except ProcessLookupError:
                        alive = False  # dead → stale lock
                    except PermissionError:
                        alive = True  # exists but not ours to signal
            except OSError:
                alive = False
            if alive:
                details = ", ".join(
                    f"{key}={owner[key]!r}" for key in ("sid", "tmux_pane", "build_log")
                    if isinstance(owner.get(key), str) and owner[key]
                )
                err(
                    f"{PROG}: another build is already running (pid {lock_pid}): {lockfile}"
                    + (f" ({details})" if details else "")
                )
                sys.exit(1)
            # Stale lock — drop it and retry.
            try:
                os.unlink(lockfile)
            except OSError:
                pass
            continue
        else:
            os.write(fd, payload)
            os.close(fd)
            _STATE["lock_held"] = True
            return


def _env_int(name: str, default: int) -> int:
    """Read an int-valued env var, falling back to `default` when unset/invalid."""
    raw = os.environ.get(name)
    if raw is None or raw == "":
        return default
    try:
        return int(raw)
    except ValueError:
        return default


def parse_args(argv: list[str]) -> tuple[list[str], str | None]:
    """Split argv into `(forward_to_lake, spine_archive_path)`.

    `spine_archive_path` is None when --spine-archive was not given (the
    default: off), otherwise the requested path — SPINE_ARCHIVE_DEFAULT for the
    bare flag, else the `=PATH` value.

    Wrapper-owned arguments (-h/--help, --spine-archive) are consumed only
    *before* the first `--`; from that separator on, everything — including the
    separator itself, which Lake accepts — is forwarded verbatim. A leading `--`
    keeps its original meaning: pure passthrough, nothing consumed.
    """
    if argv and argv[0] in ("-h", "--help"):
        sys.stdout.write(HELP)
        sys.exit(0)
    if argv and argv[0] == "--":  # explicit passthrough separator
        return argv[1:], None
    forward: list[str] = []
    archive: str | None = None
    eq_prefix = SPINE_ARCHIVE_FLAG + "="
    for i, arg in enumerate(argv):
        if arg == "--":
            forward.extend(argv[i:])
            break
        if arg == SPINE_ARCHIVE_FLAG:
            archive = SPINE_ARCHIVE_DEFAULT
        elif arg.startswith(eq_prefix):
            archive = arg[len(eq_prefix):]
            if not archive:
                err(f"{PROG}: {eq_prefix}PATH needs a non-empty path "
                    f"(bare {SPINE_ARCHIVE_FLAG} uses {SPINE_ARCHIVE_DEFAULT})")
                sys.exit(2)
        else:
            forward.append(arg)
    return forward, archive


def _append_jsonl(path: str, record: dict) -> None:
    """Append one JSON record as a line to `path`, flushed to disk before the
    call returns so an interrupt mid-build keeps every record written so far.
    Best-effort: a write failure never propagates."""
    try:
        with open(path, "a", encoding="utf-8") as fh:
            fh.write(json.dumps(record) + "\n")
    except OSError:
        pass


def parse_built_line(line: str):
    """Extract (module, duration_s, warnings) from a Lake `Built` progress line,
    or None if `line` isn't one.

    Lake prints one line per (re)compiled module:
        ✔ [k/n] Built Some.Dotted.Module (4.0s)
        ⚠ [k/n] Built Some.Dotted.Module (12s)     # built, but with warnings
    The trailing `(Ns)` is the module's own build time; the leading glyph is ✔
    (clean) or ⚠ (warnings). Module names are dotted identifiers with no spaces
    or parens, so a plain rsplit on the last ` (` is unambiguous — no regex.
    Returns None when the shape doesn't match (duration stays None if the paren
    token isn't a `<number>s` time)."""
    marker = "] Built "
    idx = line.find(marker)
    if idx < 0:
        return None
    warnings = "⚠" in line[:idx]
    rest = line[idx + len(marker):].strip()
    if not rest.endswith(")") or " (" not in rest:
        return None
    module, paren = rest.rsplit(" (", 1)
    module = module.strip()
    if not module:
        return None
    token = paren[:-1]  # drop trailing ')'
    duration = None
    try:
        if token.endswith("ms"):
            duration = round(float(token[:-2]) / 1000.0, 3)
        elif token.endswith("s"):
            duration = float(token[:-1])
    except ValueError:
        duration = None
    return module, duration, warnings


def spine_files(proj_dir: str) -> list[str] | None:
    """The ACTIVE spine source files, via `proof-blueprint spine --files`.

    That mode puts one absolute .lean path per line on stdout and every other
    message on stderr, so the list needs no parsing and its exit code answers
    "is there a list?" rather than "is the spine closed?" — an open spine (the
    normal state) is not a failure here. Returns None on any nonzero exit; the
    child's stderr is left attached so its diagnosis reaches the user.
    """
    try:
        res = subprocess.run(
            ["proof-blueprint", "spine", "--files"],
            cwd=proj_dir, stdout=subprocess.PIPE, text=True,
            encoding="utf-8", errors="replace",
        )
    except OSError as exc:
        err(f"{PROG}: could not run `proof-blueprint spine --files`: {exc}")
        return None
    if res.returncode != 0:
        err(f"{PROG}: `proof-blueprint spine --files` exited {res.returncode}")
        return None
    return [ln.strip() for ln in res.stdout.splitlines() if ln.strip()]


def strip_lean_comments(line: str, depth: int) -> tuple[str, int]:
    """`(code_outside_comments, new_depth)` for one line at nesting `depth`.

    Handles Lean's nesting `/- … -/` block comments (including the `/-!` and
    `/--` doc forms, which share the `/-` opener) and `--` line comments. Every
    source file here opens with a license block whose *body* lines look like
    ordinary text, so a scanner that doesn't track depth reads the first of
    those as code — which is why this exists rather than a per-line prefix test.
    """
    out: list[str] = []
    i = 0
    n = len(line)
    while i < n:
        two = line[i:i + 2]
        if depth > 0:
            if two == "-/":
                depth -= 1
                i += 2
            elif two == "/-":
                depth += 1
                i += 2
            else:
                i += 1
            continue
        if two == "/-":
            depth += 1
            i += 2
            continue
        if two == "--":
            break  # line comment — the rest of the line is not code
        out.append(line[i])
        i += 1
    return "".join(out), depth


def lean_imports(path: str) -> list[str]:
    """Module names imported by a Lean source file.

    Lean requires the import block at the top of the file, so the scan stops at
    the first real command. Comments are stripped with the depth-tracking
    scanner above, so a leading license block doesn't end the scan early.
    """
    mods: list[str] = []
    depth = 0
    try:
        with open(path, "r", encoding="utf-8", errors="replace") as fh:
            for raw in fh:
                code, depth = strip_lean_comments(raw, depth)
                line = code.strip()
                if line == "":
                    continue
                if line.startswith("import "):
                    token = line[len("import "):].strip().split()
                    if token:
                        mods.append(token[0])
                    continue
                if line in ("prelude", "module"):
                    continue
                break  # first real command — the import block is over
    except OSError:
        pass
    return mods


def unsatisfied_imports(members: set[str], lean_lib: str | None) -> list[str]:
    """Project modules imported by the archived sources but absent from them.

    A module counts as a project module only when its source exists under
    `lean_lib` — that's what separates a same-tree import from Mathlib/Init,
    which legitimately aren't in the archive. With no `lean_lib` the test can't
    be made, so nothing is reported rather than everything.
    """
    if not lean_lib:
        return []
    missing: set[str] = set()
    for path in members:
        for mod in lean_imports(path):
            src = os.path.join(lean_lib, *mod.split(".")) + ".lean"
            if os.path.isfile(src) and src not in members:
                missing.add(mod)
    return sorted(missing)


def write_spine_archive(out_path: str, lean_root: str, members: list[str]) -> None:
    """Write `members` to `out_path` as a gzipped tar, atomically.

    Every entry lands under one top-level directory named for the archive, at
    its path relative to the Lake root, so unpacking never scatters files into
    the cwd. Ownership is zeroed: the archive is meant to be handed to someone
    else, and the builder's uid/gid is not part of the proof.
    """
    top = os.path.basename(out_path)
    for suffix in (".tar.gz", ".tgz", ".tar"):
        if top.endswith(suffix):
            top = top[: -len(suffix)]
            break
    tmp_path = out_path + ".tmp"

    def normalize(info: tarfile.TarInfo) -> tarfile.TarInfo:
        info.uid = info.gid = 0
        info.uname = info.gname = ""
        return info

    with tarfile.open(tmp_path, "w:gz") as tar:
        for path in members:
            arcname = os.path.join(top, os.path.relpath(path, lean_root))
            tar.add(path, arcname=arcname, filter=normalize)
    os.replace(tmp_path, out_path)


def make_spine_archive(requested: str, proj_dir: str, lean_root: str) -> bool:
    """Pack the ACTIVE spine sources plus build scaffolding into a .tar.gz.

    Returns True on success. Unlike the blueprint refresh above, this is NOT
    best-effort: the archive was explicitly asked for, so a failure is reported
    and surfaced in the exit code rather than silently skipped.
    """
    out_path = requested if os.path.isabs(requested) else os.path.join(proj_dir, requested)
    files = spine_files(proj_dir)
    if files is None:
        return False
    if not files:
        err(f"{PROG}: spine is empty — no active files to archive")
        return False

    members: list[str] = []
    outside = 0
    for path in files:
        if not os.path.isfile(path):
            continue  # index drift: a dropped source is simply not archived
        rel = os.path.relpath(path, lean_root)
        if rel.startswith(os.pardir + os.sep) or rel == os.pardir:
            outside += 1
            continue
        members.append(path)
    if outside:
        err(f"{PROG}: {outside} spine file(s) live outside the Lake root "
            f"{lean_root} and were skipped")
    n_spine = len(members)
    if not n_spine:
        err(f"{PROG}: no spine file resolved to a real source under {lean_root}")
        return False

    spine_set = set(members)
    for name in SPINE_ARCHIVE_SCAFFOLDING:
        candidate = os.path.join(lean_root, name)
        if os.path.isfile(candidate):
            members.append(candidate)

    try:
        os.makedirs(os.path.dirname(out_path) or ".", exist_ok=True)
        write_spine_archive(out_path, lean_root, members)
    except (OSError, tarfile.TarError) as exc:
        err(f"{PROG}: could not write {out_path}: {exc}")
        return False

    size_kb = os.path.getsize(out_path) // 1024
    err(f"{PROG}: wrote {out_path} — {n_spine} active spine file(s) + "
        f"{len(members) - n_spine} scaffolding file(s), {size_kb} KB")

    # The spine set is reachability-derived, not import-closed. Say so with the
    # actual names rather than letting "buildable tree" go unqualified.
    bp = find_blueprint(lean_root)
    lean_lib = None
    if bp:
        rel_lib = blueprint_paths_value(bp, ("lean_lib",))
        if rel_lib:
            lean_lib = os.path.join(os.path.dirname(bp), rel_lib)
    missing = unsatisfied_imports(spine_set, lean_lib)
    if missing:
        shown = ", ".join(missing[:SPINE_ARCHIVE_MAX_LISTED])
        more = len(missing) - SPINE_ARCHIVE_MAX_LISTED
        if more > 0:
            shown += f", … {more} more"
        err(f"{PROG}: archive is NOT import-closed — {len(missing)} project "
            f"module(s) imported by spine files are off-spine and absent: {shown}")
    return True


def main() -> int:
    forward_args, spine_archive = parse_args(sys.argv[1:])

    # --- resolve the Lake root --------------------------------------------
    # Precedence: $LEAN_ROOT > walk up from cwd to a lakefile > .blueprint.toml
    # [paths].lean_root|lean_lib. The blueprint step finds a Lake tree living in
    # a *subdir* when you invoke from the project root above it.
    lean_root = os.environ.get("LEAN_ROOT") or find_lean_root(os.getcwd()) or find_lean_root_via_blueprint()
    if not lean_root or not os.path.isdir(lean_root):
        err(
            f"{PROG}: no lakefile.toml/lakefile.lean found from {os.getcwd()} upward, "
            "and no .blueprint.toml [paths].lean_root/lean_lib pointed to one "
            "(set LEAN_ROOT to override)"
        )
        return 1

    memory_mb = _env_int("MEMORY_MB", 16384)
    lockfile = os.environ.get("LOCKFILE") or os.path.join(lean_root, ".lake", "lake-build.lock")
    real_lake = os.environ.get("REAL_LAKE") or shutil.which("lake")
    real_lean = os.environ.get("REAL_LEAN") or shutil.which("lean")
    if not real_lake or not real_lean:
        err(f"{PROG}: lake/lean not found on PATH (set REAL_LAKE / REAL_LEAN to override)")
        return 1

    stats_dir = os.environ.get("LEAN_USAGE_STATE_DIR") or os.path.join(
        os.path.expanduser("~"), ".local", "state", "lean-usage"
    )
    stats_file = os.path.join(stats_dir, "build-stats.jsonl")
    module_stats_file = os.path.join(stats_dir, "module-build-stats.jsonl")
    # One id shared by this build's per-build record and all its per-module
    # records, so the two JSONL files join on build_id.
    build_id = f"{os.getpid()}-{time.time_ns()}"
    log_dir = os.path.join(os.path.dirname(os.path.abspath(lockfile)), "lake-build-logs")
    build_log = os.path.join(log_dir, f"{build_id}.log")
    capture_modules = not os.environ.get("LAKE_BUILD_NO_MODULE_STATS")
    budget_target_s = _env_int("LAKE_BUILD_TARGET_S", 600)  # 10 min — target
    budget_ceil_s = _env_int("LAKE_BUILD_CEIL_S", 1800)  # 30 min — refactor ceiling

    os.makedirs(os.path.dirname(lockfile), exist_ok=True)
    os.makedirs(stats_dir, exist_ok=True)

    # Cleanup must be in place before we create the shim dir or take the lock.
    # finalize_build_stats is registered last so atexit's LIFO order runs it
    # first — the partial per-build record is written before the shim dir/lock
    # are torn down.
    atexit.register(cleanup)
    atexit.register(finalize_build_stats)
    for sig in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
        signal.signal(sig, _signal_exit)

    wrap_dir = tempfile.mkdtemp(prefix="lake-build-wrap.", dir=os.environ.get("TMPDIR") or "/tmp")
    _STATE["wrap_dir"] = wrap_dir
    _STATE["lockfile"] = lockfile

    acquire_lock(lockfile, build_log)
    os.makedirs(log_dir, exist_ok=True)
    _STATE["log_file"] = open(build_log, "x", encoding="utf-8")
    err(f"{PROG}: build log: {build_log}")

    # memory-cap shim: intercept `lean` and inject -M before exec'ing the real one.
    lean_shim = os.path.join(wrap_dir, "lean")
    with open(lean_shim, "w", encoding="utf-8") as fh:
        fh.write(
            "#!/usr/bin/env bash\n"
            f'exec "{real_lean}" -M "{memory_mb}" "$@"\n'
        )
    os.chmod(lean_shim, 0o755)

    build_env = os.environ.copy()
    build_env["PATH"] = wrap_dir + os.pathsep + build_env.get("PATH", "")

    # Always ask mathlib's cache client to fill or verify the binary cache before
    # building. The command is incremental when the cache is already present.
    # Failing closed prevents an unavailable/incomplete cache from silently
    # turning an ordinary lake-build invocation into a source build of mathlib.
    if uses_mathlib(lean_root):
        err(f"{PROG}: prefetching mathlib cache: lake exe cache get")
        cache_proc = subprocess.Popen(
            [real_lake, "exe", "cache", "get"],
            cwd=lean_root,
            env=build_env,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            text=True,
            encoding="utf-8",
            errors="replace",
            bufsize=1,
        )
        _BUILD["proc"] = cache_proc
        assert cache_proc.stdout is not None
        cache_stdout_open = True
        for line in cache_proc.stdout:
            write_build_log(line)
            if cache_stdout_open:
                try:
                    sys.stdout.write(line)
                    sys.stdout.flush()
                except BrokenPipeError:
                    cache_stdout_open = False
                    try:
                        os.dup2(os.open(os.devnull, os.O_WRONLY), sys.stdout.fileno())
                    except OSError:
                        pass
        cache_proc.stdout.close()
        cache_exit = cache_proc.wait()
        _BUILD["proc"] = None
        if cache_exit != 0:
            err(f"{PROG}: mathlib cache prefetch failed ({cache_exit}); refusing source build")
            return cache_exit or 1

    # --- run + time -------------------------------------------------------
    # A build is dead time if you watch it compile — nudge toward working ahead.
    err(
        f"{PROG}: building — don't just wait on it. Update docstrings/module docs/"
        "blueprint entries for what you just wrote, stage the next edit or commit "
        "message, or line up the next module while this runs."
    )

    # Stream Lake's merged output live (like `... 2>&1 | tee`) while counting how
    # many targets it actually (re)compiled and recording each module's own build
    # time. Piping means Lake emits its plain, non-TTY progress lines rather than
    # the animated bar. One "✔ [k/n] Built <Module> (Ns)" line per (re)compiled
    # target — Lake already reports each module's wall-clock in that line, so the
    # per-module stats come straight from the stream we're already draining (no
    # per-module process hook: Lake spawns `lean` by absolute toolchain path, so
    # a PATH shim never sees the compiles). Zero Built lines means a fully-cached
    # no-op (Lake is content-hash based); the "(N jobs)" summary prints even for a
    # no-op, so it is NOT the signal.
    markers = ("] Built ", "] Building ", "] Compiling ")
    start_epoch = time.time()
    # Publish the per-build state so the atexit/signal finalizer can write a
    # partial record if this build is interrupted before proc.wait() returns.
    _BUILD["meta"] = {
        "project": lean_root,
        "args": "lake build " + " ".join(forward_args),
        "build_id": build_id,
        "memory_mb": memory_mb,
        "build_log": build_log,
    }
    _BUILD["stats_file"] = stats_file
    _BUILD["start"] = start_epoch
    proc = subprocess.Popen(
        [real_lake, "build", *forward_args],
        cwd=lean_root,
        env=build_env,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        text=True,
        encoding="utf-8",
        errors="replace",
        bufsize=1,
    )
    _BUILD["proc"] = proc
    assert proc.stdout is not None
    stdout_open = True
    for line in proc.stdout:
        write_build_log(line)
        if any(m in line for m in markers):
            _BUILD["recompiled"] += 1
        if capture_modules:
            built = parse_built_line(line)
            if built is not None:
                module, module_dur, module_warnings = built
                # Written and flushed per module, so an interrupt keeps the
                # records for every module Lake finished before the stop.
                _append_jsonl(module_stats_file, {
                    "ts": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
                    "build_id": build_id,
                    "module": module,
                    "duration_s": module_dur,
                    "warnings": module_warnings,
                })
        if stdout_open:
            try:
                sys.stdout.write(line)
                sys.stdout.flush()
            except BrokenPipeError:
                # Downstream reader (e.g. `lake-build | head`) closed early. Stop
                # echoing but keep draining Lake to completion so the build still
                # finishes and its stats get recorded — the old `| tee` pipeline
                # degraded the same way. Redirect fd 1 to /dev/null so the
                # interpreter's shutdown flush doesn't re-raise on the dead pipe.
                stdout_open = False
                try:
                    os.dup2(os.open(os.devnull, os.O_WRONLY), sys.stdout.fileno())
                except OSError:
                    pass
    proc.stdout.close()
    exit_code = proc.wait()
    err(f"{PROG}: lake build exited {exit_code}")
    duration = int(time.time() - start_epoch)

    # --- record stats (JSONL, append) -------------------------------------
    # The per-build record is written by finalize_build_stats (shared with the
    # interrupt path) so a normal build and an interrupted one produce the same
    # schema — the normal build just adds "interrupted": false. Best-effort: a
    # write failure never fails the build.
    _BUILD["exit_code"] = exit_code
    finalize_build_stats(interrupted=False)

    # --- budget nudge -----------------------------------------------------
    if exit_code == 0:
        if duration > budget_ceil_s:
            err(
                f"{PROG}: build took {duration // 60}m{duration % 60:02d}s — over the "
                f"{budget_ceil_s // 60}m refactor ceiling. Shard the slowest modules "
                "(profile with `/usr/bin/time -l lake env lean <file>`); see the "
                "lean-usage build-time budget."
            )
        elif duration > budget_target_s:
            err(
                f"{PROG}: build took {duration // 60}m{duration % 60:02d}s — over the "
                f"{budget_target_s // 60}m target; watch the slowest modules before they "
                f"cross {budget_ceil_s // 60}m."
            )

    # --- proof-blueprint post-build resync --------------------------------
    # On a successful build, resync the proof-blueprint index + kernel call graph
    # so spine/status/tree reflect the just-built oleans, then write the current
    # open-frontier blueprint to docs/live-blueprint.md. Guarded to a
    # proof-blueprint project (a .blueprint.toml at or above the Lake tree, found
    # by walking up from lean_root) with the tool installed. `proof-blueprint
    # sync` takes the project's own refresh lock, so concurrent runs serialize.
    # Best-effort: failures are reported but never fail the build.
    if exit_code == 0 and not os.environ.get("LAKE_BUILD_NO_REFRESH") and shutil.which("proof-blueprint"):
        bp = find_blueprint(lean_root)
        if bp:
            proj_dir = os.path.dirname(bp)
            err(f"{PROG}: resyncing proof-blueprint (index + call graph) …")
            sync = subprocess.run(["proof-blueprint", "sync"], cwd=proj_dir)
            if sync.returncode != 0:
                err(f"{PROG}: proof-blueprint sync failed (build OK; resync is best-effort)")
            # Snapshot the open-frontier spine. `spine` exits 1 whenever the
            # target is still open (the normal state), so its exit status is
            # deliberately ignored — the write is gated on a non-empty render.
            wrote = False
            try:
                docs_dir = os.path.join(proj_dir, "docs")
                os.makedirs(docs_dir, exist_ok=True)
                tmp_path = os.path.join(docs_dir, "live-blueprint.md.tmp")
                final_path = os.path.join(docs_dir, "live-blueprint.md")
                with open(tmp_path, "w", encoding="utf-8") as out:
                    # `spine` writes its own do-not-edit banner when stdout is a
                    # regular file, which this is — no header is added here, so
                    # the banner text has exactly one owner (the CLI).
                    subprocess.run(
                        ["proof-blueprint", "spine"],
                        cwd=proj_dir,
                        stdout=out,
                        stderr=subprocess.DEVNULL,
                    )
                if os.path.getsize(tmp_path) > 0:
                    os.replace(tmp_path, final_path)
                    wrote = True
                else:
                    os.unlink(tmp_path)
            except OSError:
                wrote = False
            if wrote:
                err(f"{PROG}: wrote {proj_dir}/docs/live-blueprint.md")
            else:
                err(f"{PROG}: could not render docs/live-blueprint.md (build OK; best-effort)")

    # --- ACTIVE spine archive (opt-in) ------------------------------------
    # Runs last, after the resync above, so the file set comes from the graph
    # this build just produced rather than the previous one. Skipped entirely
    # on a failed build: archiving sources whose oleans didn't compile would
    # hand over a snapshot the spine can't vouch for.
    if spine_archive is not None:
        if exit_code != 0:
            err(f"{PROG}: build failed — skipping {SPINE_ARCHIVE_FLAG}")
        elif not shutil.which("proof-blueprint"):
            err(f"{PROG}: {SPINE_ARCHIVE_FLAG} needs the `proof-blueprint` CLI on PATH")
            return 1
        else:
            bp = find_blueprint(lean_root)
            if not bp:
                err(f"{PROG}: {SPINE_ARCHIVE_FLAG} needs a proof-blueprint project — "
                    f"no .blueprint.toml at or above {lean_root}")
                return 1
            if not make_spine_archive(spine_archive, os.path.dirname(bp), lean_root):
                return 1

    return exit_code


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)

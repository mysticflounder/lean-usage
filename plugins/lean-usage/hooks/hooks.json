{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/opt/homebrew/bin/python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/sync-lake-build.py\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "/opt/homebrew/bin/python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/inject_anchor.py\"",
            "timeout": 8,
            "statusMessage": "proof-blueprint: anchor"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/opt/homebrew/bin/python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/lean-direct-warn.py\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "/opt/homebrew/bin/python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/mathlib-cache-check.py\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}

# lake-build-example — a portable, trimmed version of the lake-build wrapper in
# plugins/lean-usage/bin/lake-build. It keeps the parts that made the build
# telemetry in docs/reports/ possible and drops the house-specific ones
# (proof-blueprint resync, spine archives, session identity, hook deployment).
#
# From anywhere inside a Lake project it:
#   - walks up to lakefile.toml / lakefile.lean ($LEAN_ROOT overrides);
#   - serializes builds per project with a stale-PID-aware lockfile;
#   - keeps the live build output in .lake/lake-build-logs/<build_id>.log;
#   - puts a temporary `lean` shim first on PATH so every worker Lake spawns
#     through PATH gets a memory cap (-M $MEMORY_MB);
#   - runs `lake exe cache get` first when the project depends on mathlib, and
#     refuses to build if that fails, so a missing cache never turns a routine
#     build into a source build of mathlib;
#   - streams Lake's output while counting rebuild-activity lines and recording
#     each module's own compile time from Lake's "Built <module> (Ns)" lines;
#   - appends one record per build to build-stats.jsonl and one record per
#     module compile to module-build-stats.jsonl, joined by build_id; an
#     interrupt still writes the per-build record with "interrupted": true;
#   - warns when a successful build crosses the time budget.
#
# Usage:
#   lake-build-example [ARGS...]      # ARGS go verbatim to `lake build`
#   lake-build-example -- [ARGS...]   # forward everything, consume nothing
#   lake-build-example -h | --help
#
# Environment:
#   LEAN_ROOT             Explicit Lake root (overrides discovery).
#   MEMORY_MB             Per-`lean` memory cap in MB. Default 16384.
#   LOCKFILE              Lock path. Default <lake-root>/.lake/lake-build.lock.
#   REAL_LAKE, REAL_LEAN  Toolchain executables. Default: resolved on PATH.
#   LEAN_USAGE_STATE_DIR  Telemetry directory. Default ~/.local/state/lean-usage.
#   LAKE_BUILD_TARGET_S   Budget warning threshold, seconds. Default 600.
#   LAKE_BUILD_CEIL_S     Budget ceiling threshold, seconds. Default 1800.
#   LAKE_BUILD_NO_MODULE_STATS  Set to skip module-build-stats.jsonl.
#
# Reading the telemetry (jq):
#   # modules compiled per build, with the build's wall time
#   jq -r '[.build_id, .duration_s, .recompiled] | @tsv' build-stats.jsonl
#   # the ten slowest module compiles
#   jq -r '[.duration_s, .module] | @tsv' module-build-stats.jsonl | sort -rn | head
#
# A note on what these numbers mean. Every build this wrapper records is
# incremental: Lake rebuilds what changed and reuses the rest. The per-build
# wall time therefore depends on how much was stale, which the record does not
# say beyond the activity count. Treat module durations as the compile-cost
# measure and per-build durations as workflow observations.

import atexit
import json
import os
import shutil
import signal
import subprocess
import sys
import tempfile
import time
from datetime import datetime, timezone

PROG = "lake-build-example"

HELP = f"""\
{PROG} — Lean/Lake build wrapper with lockfile, memory cap, cache prefetch,
and build/module telemetry. ARGS are forwarded verbatim to `lake build`.

Usage:
  {PROG} [ARGS...]
  {PROG} -- [ARGS...]     forward everything after `--`, consume nothing
  {PROG} -h | --help

Environment: LEAN_ROOT, MEMORY_MB (16384), LOCKFILE, REAL_LAKE, REAL_LEAN,
LEAN_USAGE_STATE_DIR (~/.local/state/lean-usage), LAKE_BUILD_TARGET_S (600),
LAKE_BUILD_CEIL_S (1800), LAKE_BUILD_NO_MODULE_STATS.

Telemetry (under LEAN_USAGE_STATE_DIR):
  build-stats.jsonl         one record per build: ts, project, args, duration_s,
                            exit_code, recompiled, memory_mb, build_id, build_log,
                            interrupted
  module-build-stats.jsonl  one record per module compile: ts, build_id, module,
                            duration_s, warnings
"""

# Shared with the atexit/signal handlers so an interrupted build still cleans up
# and still writes its partial per-build record.
_STATE = {"wrap_dir": None, "lockfile": None, "lock_held": False, "log_file": None}
_BUILD = {"start": None, "recompiled": 0, "exit_code": None, "recorded": False,
          "stats_file": None, "meta": None, "proc": None}


def now_utc() -> str:
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def write_build_log(text: str) -> None:
    log_file = _STATE.get("log_file")
    if log_file is None:
        return
    try:
        log_file.write(text)
        log_file.flush()
    except (OSError, ValueError):
        _STATE["log_file"] = None


def err(msg: str) -> None:
    """The wrapper's own channel is stderr; Lake's output goes to stdout."""
    write_build_log(msg + "\n")
    sys.stderr.write(msg + "\n")
    sys.stderr.flush()


def env_int(name: str, default: int) -> int:
    raw = os.environ.get(name, "")
    try:
        return int(raw) if raw else default
    except ValueError:
        return default


def append_jsonl(path: str, record: dict) -> None:
    """Append and flush one record. Best-effort: a write failure never fails the build."""
    try:
        with open(path, "a", encoding="utf-8") as fh:
            fh.write(json.dumps(record) + "\n")
    except OSError:
        pass


# --- locate the project ---------------------------------------------------
def find_lean_root(start: str) -> str | None:
    d = os.path.abspath(start)
    while True:
        for name in ("lakefile.toml", "lakefile.lean"):
            if os.path.isfile(os.path.join(d, name)):
                return d
        parent = os.path.dirname(d)
        if parent == d:
            return None
        d = parent


def uses_mathlib(lean_root: str) -> bool:
    try:
        with open(os.path.join(lean_root, "lake-manifest.json"), encoding="utf-8") as fh:
            if any(isinstance(p, dict) and p.get("name") == "mathlib"
                   for p in json.load(fh).get("packages", [])):
                return True
    except (OSError, ValueError, AttributeError):
        pass
    for name in ("lakefile.toml", "lakefile.lean"):
        try:
            with open(os.path.join(lean_root, name), encoding="utf-8") as fh:
                if "mathlib" in fh.read().lower():
                    return True
        except OSError:
            pass
    return False


# --- lockfile, cleanup, signals ------------------------------------------
def acquire_lock(lockfile: str, build_log: str) -> None:
    """PID lock. Line one is the PID; line two is informational JSON. A lock
    whose PID is dead is reclaimed; a live one makes this run exit 1."""
    payload = f"{os.getpid()}\n{json.dumps({'build_log': build_log})}\n".encode()
    while True:
        try:
            fd = os.open(lockfile, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o644)
        except FileExistsError:
            lock_pid, alive, owner = None, False, {}
            try:
                with open(lockfile, encoding="utf-8", errors="replace") as fh:
                    first = fh.readline().strip()
                    try:
                        meta = json.loads(fh.readline())
                        owner = meta if isinstance(meta, dict) else {}
                    except ValueError:
                        pass
                if first.isdigit():
                    lock_pid = int(first)
                    try:
                        os.kill(lock_pid, 0)
                        alive = True
                    except ProcessLookupError:
                        alive = False
                    except PermissionError:
                        alive = True
            except OSError:
                alive = False
            if alive:
                log = owner.get("build_log")
                err(f"{PROG}: another build is already running (pid {lock_pid}): {lockfile}"
                    + (f" (log: {log})" if isinstance(log, str) and log else ""))
                sys.exit(1)
            try:
                os.unlink(lockfile)   # stale: reclaim and retry
            except OSError:
                pass
            continue
        os.write(fd, payload)
        os.close(fd)
        _STATE["lock_held"] = True
        return


def finalize_build_stats(interrupted: bool = True) -> None:
    """Write the per-build record exactly once. Normal completion calls it with
    interrupted=False; atexit calls it again as a no-op, or as the only call
    after Ctrl-C / SIGTERM, when it records the partial build."""
    if _BUILD["recorded"] or _BUILD["start"] is None or _BUILD["meta"] is None:
        return
    _BUILD["recorded"] = True
    code = _BUILD["exit_code"]
    record = dict(_BUILD["meta"])
    record.update({
        "ts": now_utc(),
        "duration_s": int(time.time() - _BUILD["start"]),
        "exit_code": 130 if code is None else code,
        "recompiled": _BUILD["recompiled"],
        "interrupted": interrupted,
    })
    append_jsonl(_BUILD["stats_file"], record)


def cleanup() -> None:
    """Remove the shim dir and, only if this process took it, the lockfile."""
    if _STATE["wrap_dir"]:
        shutil.rmtree(_STATE["wrap_dir"], ignore_errors=True)
    log_file = _STATE.get("log_file")
    if log_file is not None:
        _STATE["log_file"] = None
        try:
            log_file.close()
        except OSError:
            pass
    if _STATE["lock_held"] and _STATE["lockfile"]:
        try:
            os.unlink(_STATE["lockfile"])
        except OSError:
            pass


def signal_exit(signum, _frame):
    """Terminate the running lake and leave through the normal exit path so the
    atexit handlers record the partial build and release the lock."""
    _BUILD["exit_code"] = 128 + signum
    proc = _BUILD["proc"]
    if proc is not None:
        try:
            proc.terminate()
        except Exception:
            pass
    sys.exit(128 + signum)


# --- Lake output parsing ---------------------------------------------------
ACTIVITY_MARKERS = ("] Built ", "] Building ", "] Compiling ")


def parse_built_line(line: str):
    """(module, duration_s, warnings) from a line like
         ✔ [12/40] Built Foo.Bar (4.0s)
         ⚠ [13/40] Built Foo.Baz (12s)
    or None. Module names have no spaces or parentheses, so splitting on the
    last " (" is unambiguous."""
    idx = line.find("] Built ")
    if idx < 0:
        return None
    warnings = "⚠" in line[:idx]
    rest = line[idx + len("] Built "):].strip()
    if not rest.endswith(")") or " (" not in rest:
        return None
    module, paren = rest.rsplit(" (", 1)
    module = module.strip()
    if not module:
        return None
    token = paren[:-1]
    duration = None
    try:
        if token.endswith("ms"):
            duration = round(float(token[:-2]) / 1000.0, 3)
        elif token.endswith("s"):
            duration = float(token[:-1])
    except ValueError:
        pass
    return module, duration, warnings


def stream(proc: subprocess.Popen, on_line=None) -> int:
    """Echo a child's merged output live, log it, and keep draining even if the
    reader of our stdout goes away (so the build still finishes and is recorded)."""
    assert proc.stdout is not None
    stdout_open = True
    for line in proc.stdout:
        write_build_log(line)
        if on_line is not None:
            on_line(line)
        if stdout_open:
            try:
                sys.stdout.write(line)
                sys.stdout.flush()
            except BrokenPipeError:
                stdout_open = False
                try:
                    os.dup2(os.open(os.devnull, os.O_WRONLY), sys.stdout.fileno())
                except OSError:
                    pass
    proc.stdout.close()
    return proc.wait()


def popen(cmd: list[str], cwd: str, env: dict) -> subprocess.Popen:
    return subprocess.Popen(cmd, cwd=cwd, env=env, stdout=subprocess.PIPE,
                            stderr=subprocess.STDOUT, text=True, encoding="utf-8",
                            errors="replace", bufsize=1)


# --- main -----------------------------------------------------------------
def main() -> int:
    argv = sys.argv[1:]
    if argv and argv[0] in ("-h", "--help"):
        sys.stdout.write(HELP)
        return 0
    forward_args = argv[1:] if argv and argv[0] == "--" else argv

    lean_root = os.environ.get("LEAN_ROOT") or find_lean_root(os.getcwd())
    if not lean_root or not os.path.isdir(lean_root):
        err(f"{PROG}: no lakefile.toml/lakefile.lean found from {os.getcwd()} upward "
            "(set LEAN_ROOT to override)")
        return 1

    real_lake = os.environ.get("REAL_LAKE") or shutil.which("lake")
    real_lean = os.environ.get("REAL_LEAN") or shutil.which("lean")
    if not real_lake or not real_lean:
        err(f"{PROG}: lake/lean not found on PATH (set REAL_LAKE / REAL_LEAN to override)")
        return 1

    memory_mb = env_int("MEMORY_MB", 16384)
    budget_target_s = env_int("LAKE_BUILD_TARGET_S", 600)
    budget_ceil_s = env_int("LAKE_BUILD_CEIL_S", 1800)
    lockfile = os.environ.get("LOCKFILE") or os.path.join(lean_root, ".lake", "lake-build.lock")
    stats_dir = os.environ.get("LEAN_USAGE_STATE_DIR") or os.path.join(
        os.path.expanduser("~"), ".local", "state", "lean-usage")
    stats_file = os.path.join(stats_dir, "build-stats.jsonl")
    module_stats_file = os.path.join(stats_dir, "module-build-stats.jsonl")
    capture_modules = not os.environ.get("LAKE_BUILD_NO_MODULE_STATS")
    build_id = f"{os.getpid()}-{time.time_ns()}"
    log_dir = os.path.join(os.path.dirname(os.path.abspath(lockfile)), "lake-build-logs")
    build_log = os.path.join(log_dir, f"{build_id}.log")

    os.makedirs(os.path.dirname(lockfile), exist_ok=True)
    os.makedirs(stats_dir, exist_ok=True)

    # atexit runs LIFO: the per-build record is written before the shim dir and
    # lock are torn down.
    atexit.register(cleanup)
    atexit.register(finalize_build_stats)
    for sig in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
        signal.signal(sig, signal_exit)

    wrap_dir = tempfile.mkdtemp(prefix="lake-build-wrap.", dir=os.environ.get("TMPDIR") or "/tmp")
    _STATE.update(wrap_dir=wrap_dir, lockfile=lockfile)

    acquire_lock(lockfile, build_log)
    os.makedirs(log_dir, exist_ok=True)
    _STATE["log_file"] = open(build_log, "x", encoding="utf-8")
    err(f"{PROG}: build log: {build_log}")

    # Memory-cap shim. Lake starts `lean` workers through PATH in the ordinary
    # case; each one receives -M so a single runaway elaboration cannot take the
    # machine down. Compiles Lake starts by absolute toolchain path bypass it.
    lean_shim = os.path.join(wrap_dir, "lean")
    with open(lean_shim, "w", encoding="utf-8") as fh:
        fh.write(f'#!/usr/bin/env bash\nexec "{real_lean}" -M "{memory_mb}" "$@"\n')
    os.chmod(lean_shim, 0o755)
    build_env = os.environ.copy()
    build_env["PATH"] = wrap_dir + os.pathsep + build_env.get("PATH", "")

    # Fail closed on the mathlib cache: `cache get` is incremental when the cache
    # is present, and refusing to continue on failure is what keeps a missing
    # cache from becoming a multi-hour source build of mathlib.
    if uses_mathlib(lean_root):
        err(f"{PROG}: prefetching mathlib cache: lake exe cache get")
        cache_proc = popen([real_lake, "exe", "cache", "get"], lean_root, build_env)
        _BUILD["proc"] = cache_proc
        cache_exit = stream(cache_proc)
        _BUILD["proc"] = None
        if cache_exit != 0:
            err(f"{PROG}: mathlib cache prefetch failed ({cache_exit}); refusing source build")
            return cache_exit or 1

    # Piping Lake's output makes it print plain progress lines instead of the
    # animated bar: one "Built <module> (Ns)" line per module it compiled, with
    # that module's own wall time. Zero such lines is a fully cached no-op; the
    # "(N jobs)" summary prints even then and is not the signal.
    _BUILD.update(meta={
        "project": lean_root,
        "args": "lake build " + " ".join(forward_args),
        "build_id": build_id,
        "memory_mb": memory_mb,
        "build_log": build_log,
    }, stats_file=stats_file, start=time.time())

    def on_line(line: str) -> None:
        if any(m in line for m in ACTIVITY_MARKERS):
            _BUILD["recompiled"] += 1
        if capture_modules:
            built = parse_built_line(line)
            if built is not None:
                module, duration, warnings = built
                append_jsonl(module_stats_file, {
                    "ts": now_utc(), "build_id": build_id, "module": module,
                    "duration_s": duration, "warnings": warnings,
                })

    proc = popen([real_lake, "build", *forward_args], lean_root, build_env)
    _BUILD["proc"] = proc
    exit_code = stream(proc, on_line)
    _BUILD["proc"] = None
    _BUILD["exit_code"] = exit_code
    finalize_build_stats(interrupted=False)
    duration = int(time.time() - _BUILD["start"])
    err(f"{PROG}: lake build exited {exit_code} after {duration // 60}m{duration % 60:02d}s; "
        f"{_BUILD['recompiled']} rebuild-activity lines")

    if exit_code == 0 and duration > budget_ceil_s:
        err(f"{PROG}: over the {budget_ceil_s // 60}m ceiling. Find the slowest modules in "
            f"module-build-stats.jsonl for build_id {build_id} and shard or restructure them.")
    elif exit_code == 0 and duration > budget_target_s:
        err(f"{PROG}: over the {budget_target_s // 60}m target; watch the slowest modules "
            f"before they cross {budget_ceil_s // 60}m.")
    return exit_code


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
